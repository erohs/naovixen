{
    "hooks": {
        "PreToolUse": [
            {
                "matcher": "Bash",
                "hooks": [
                    {
                        "type": "command",
                        "if": "Bash(git commit*)",
                        "shell": "bash",
                        "command": "pnpm lint >&2 || exit 2",
                        "timeout": 300,
                        "statusMessage": "Linting before commit"
                    }
                ]
            },
            {
                "matcher": "PowerShell",
                "hooks": [
                    {
                        "type": "command",
                        "if": "PowerShell(git commit*)",
                        "shell": "bash",
                        "command": "pnpm lint >&2 || exit 2",
                        "timeout": 300,
                        "statusMessage": "Linting before commit"
                    }
                ]
            }
        ]
    }
}
