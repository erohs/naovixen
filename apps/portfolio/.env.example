# Server only. Never prefix these with VITE_, which would ship them to the browser.

# A Sanity token with the Viewer role (sanity.io/manage → API → Tokens). Reads drafts for
# preview and checks the Studio's preview secrets. Without it, preview stays off.
SANITY_API_READ_TOKEN=

# At least 32 random characters. Seals the preview cookie. Without it, preview stays off.
# Generate one with: node -e "console.log(crypto.randomBytes(32).toString('base64url'))"
PREVIEW_SESSION_SECRET=
