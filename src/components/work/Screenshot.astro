---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

/** The largest thing on a project page, so it loads first rather than lazily. */
interface Props {
    src: ImageMetadata;
    alt: string;
}

const { src, alt } = Astro.props;
---

<Image
    src={src}
    alt={alt}
    widths={[640, 1280, 1600]}
    sizes="(width < 45rem) 100vw, 45rem"
    priority
    class="screenshot"
/>

<style>
    .screenshot {
        inline-size: 100%;
        block-size: auto;
        aspect-ratio: 16 / 9;
        object-fit: cover;
        border: var(--border-width-standout) solid var(--color-border);
        border-radius: var(--radius-medium-alternate);
        background-color: var(--color-background-surface);
    }
</style>
