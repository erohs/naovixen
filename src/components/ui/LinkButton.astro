---
import type { HTMLAttributes } from "astro/types";
import { isExternal } from "../../lib/is-external";
import Icon from "./Icon.astro";

/** An icon-only button shows its icon and reads out its label; any other shows what it holds. */
type Props = HTMLAttributes<"a"> & {
    href: string;
    variant?: "primary" | "secondary";
} & ({ icon: string; iconLabel: string } | { icon?: never; iconLabel?: never });

const { href, variant = "secondary", iconLabel, icon, class: className, ...attributes } = Astro.props;
const opensElsewhere = isExternal(href);
---

<a
    href={href}
    class:list={["button", `button--${variant}`, iconLabel !== undefined && "button--round", className]}
    target={opensElsewhere ? "_blank" : undefined}
    rel={opensElsewhere ? "noopener noreferrer" : undefined}
    {...attributes}>
    {iconLabel === undefined ? (
        <slot />
    ) : (
        <>
            <Icon name={icon} />
            <span class="visually-hidden">{iconLabel}</span>
        </>
    )}
    {opensElsewhere && <span class="visually-hidden">(opens in new tab)</span>}
</a>
