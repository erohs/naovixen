---
import type { HTMLAttributes } from "astro/types";
import Icon from "./Icon.astro";

type Props = HTMLAttributes<"a"> & {
    href: string;
    variant?: "primary" | "secondary";
    /** Names an icon-only button: the icon is shown and this label is read out. */
    iconLabel?: string;
    icon?: string;
};

const { href, variant = "secondary", iconLabel, icon, class: className, ...attributes } = Astro.props;
const isExternal = /^([a-z][a-z\d+.-]*:)?\/\//i.test(href);
---

<a
    href={href}
    class:list={["button", `button--${variant}`, iconLabel !== undefined && "button--round", className]}
    target={isExternal ? "_blank" : undefined}
    rel={isExternal ? "noopener noreferrer" : undefined}
    {...attributes}>
    {iconLabel === undefined ? (
        <slot />
    ) : (
        <>
            <Icon name={icon ?? "arrow-right"} />
            <span class="visually-hidden">{iconLabel}</span>
        </>
    )}
    {isExternal && <span class="visually-hidden">(opens in new tab)</span>}
</a>
