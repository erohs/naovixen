---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
    src: ImageMetadata;
    alt: string;
    caption?: string | undefined;
    shape?: "wide" | "portrait";
    /** The largest thing above the fold loads first rather than lazily. */
    isPriority?: boolean;
}

const { src, alt, caption, shape = "wide", isPriority = false } = Astro.props;
---

<figure class:list={["figure", `figure--${shape}`]}>
    <Image
        src={src}
        alt={alt}
        widths={[640, 1280, 1600]}
        sizes="(width < 45rem) 100vw, 45rem"
        priority={isPriority}
        class="image"
    />
    {caption && <figcaption class="caption">{caption}</figcaption>}
</figure>

<style>
    .figure {
        display: grid;
        gap: var(--space-between-text);
    }

    .image {
        inline-size: 100%;
        block-size: auto;
        aspect-ratio: 16 / 9;
        object-fit: cover;
        border: var(--border-width-standout) solid var(--color-border);
        border-radius: var(--radius-medium-alternate);
        background-color: var(--color-background-surface);
    }

    .figure--portrait .image {
        aspect-ratio: 4 / 5;
        border-radius: var(--radius-large-alternate);
        rotate: 1.5deg;
    }

    .caption {
        color: var(--color-text-secondary);
        font-size: var(--font-size-small);
    }
</style>
