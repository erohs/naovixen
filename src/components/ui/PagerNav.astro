---
import Icon from "./Icon.astro";
import Link from "./Link.astro";

interface INeighbour {
    title: string;
    href: string;
}

interface Props {
    label: string;
    back: { label: string; href: string };
    previous?: INeighbour | undefined;
    next?: INeighbour | undefined;
}

const { label, back, previous, next } = Astro.props;
---

<nav aria-label={label} class="pager">
    <Link href={back.href} variant="standalone">
        <Icon name="arrow-left" /> {back.label}
    </Link>
    {(previous || next) && (
        <div class="neighbours">
            {previous && (
                <a href={previous.href} class="neighbour">
                    <span class="direction">Previous</span>
                    <span class="title">
                        <Icon name="arrow-left" /> {previous.title}
                    </span>
                </a>
            )}
            {next && (
                <a href={next.href} class="neighbour neighbour--next">
                    <span class="direction">Next</span>
                    <span class="title">
                        {next.title} <Icon name="arrow-right" />
                    </span>
                </a>
            )}
        </div>
    )}
</nav>

<style>
    .pager {
        display: flex;
        flex-direction: column;
        align-items: start;
        gap: var(--space-between-groups);
    }

    /* Previous keeps to the start and next to the end, even when it is the only one. */
    .neighbours {
        display: flex;
        flex-wrap: wrap;
        justify-content: space-between;
        gap: var(--space-between-blocks) var(--space-between-groups);
        inline-size: 100%;
    }

    .title {
        display: inline-flex;
        align-items: center;
        gap: var(--space-between-text);
        font-size: var(--font-size-lead);
        line-height: var(--line-height-subheading);
        text-decoration: underline solid currentcolor;
        text-decoration-thickness: var(--border-width-standout);
        text-decoration-skip-ink: none;
        text-underline-offset: var(--size-underline-offset);
    }

    .neighbour {
        display: inline-flex;
        flex-direction: column;
        gap: var(--space-between-lines);
        max-inline-size: 100%;
        padding: var(--space-between-text) calc(var(--space-between-text) + var(--space-between-lines));
        margin: calc(-1 * var(--space-between-text)) calc(-1 * (var(--space-between-text) + var(--space-between-lines)));
        border-radius: var(--radius-small);
        font-weight: var(--font-weight-semi-bold);
        text-decoration-line: none;
        transition:
            background-color var(--duration-fast) var(--easing-standard),
            color var(--duration-fast) var(--easing-standard);

        &:hover .title {
            text-decoration-style: wavy;
        }

        &:focus-visible {
            outline: none;
            background-color: var(--color-shadow);
            color: var(--color-background-surface);
        }
    }

    .neighbour--next {
        align-items: end;
        margin-inline-start: auto;
        text-align: end;
    }

    .direction {
        color: var(--color-text-secondary);
        font-family: var(--font-family-code);
        font-size: var(--font-size-meta);
        font-weight: var(--font-weight-regular);
    }

    .neighbour:focus-visible .direction {
        color: inherit;
    }

    @media (forced-colors: active) {
        .neighbour:focus-visible {
            outline: var(--border-width-highlight) solid;
        }
    }
</style>
