---
const interests = [
    "Clean, minimal websites that keep accessibility in mind and don't go overboard",
    "Digital art, drawn in Photoshop on a Wacom tablet, and following artists who draw animals",
    "Indie music, such as Southarcade and Bennett Coast",
    "Gaming, especially Minecraft and racing in GTA 5, where I've topped the global leaderboard on some races",
    "Foxes. Obviously.",
];
---

<ul class="interests">
    {interests.map((interest) => (
        <li>{interest}</li>
    ))}
</ul>

<style>
    .interests {
        display: flex;
        flex-direction: column;
        gap: var(--space-between-text);
        padding-inline-start: var(--space-indent-list);

        & ::marker {
            color: var(--color-text-accent);
        }
    }
</style>
