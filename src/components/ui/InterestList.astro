---
const interests = [
    "Sketching doodles, a few of which ended up on this site",
    "Comics and graphic novels",
    "Scandinavian design, mostly admired from the sofa",
    "Mentoring apprentices, because I was one",
    "Foxes. Obviously.",
];
---

<ul class="interests">
    {interests.map((interest) => (
        <li>{interest}</li>
    ))}
</ul>

<style>
    .interests {
        display: flex;
        flex-direction: column;
        gap: var(--space-between-text);
        padding-inline-start: var(--space-indent-list);

        & ::marker {
            color: var(--color-text-accent);
        }
    }
</style>
