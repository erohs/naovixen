---
import type { HTMLAttributes } from "astro/types";
import { isExternal } from "../../lib/is-external";

type Props = HTMLAttributes<"a"> & {
    href: string;
    variant?: "content" | "standalone" | "navigation" | "plain";
};

const { href, variant = "content", class: className, ...attributes } = Astro.props;
const opensElsewhere = isExternal(href);
---

<a
    href={href}
    class:list={["link", variant !== "plain" && `link--${variant}`, className]}
    target={opensElsewhere ? "_blank" : undefined}
    rel={opensElsewhere ? "noopener noreferrer" : undefined}
    {...attributes}>
    <slot />
    {opensElsewhere && <span class="visually-hidden">(opens in new tab)</span>}
</a>

<style>
    .link--content,
    .link--standalone,
    .link--navigation {
        --link-padding-block: 0rem;
        --link-padding-inline: var(--space-between-lines);

        margin: calc(-1 * var(--link-padding-block)) calc(-1 * var(--link-padding-inline));
        padding: var(--link-padding-block) var(--link-padding-inline);
        border-radius: var(--radius-small);
        color: var(--color-text-primary);
        font-weight: var(--font-weight-semi-bold);
        text-decoration: underline solid currentcolor;
        text-decoration-thickness: var(--border-width-standout);
        text-decoration-skip-ink: none;
        box-decoration-break: clone;
        transition:
            background-color var(--duration-fast) var(--easing-standard),
            color var(--duration-fast) var(--easing-standard);

        &:hover {
            text-decoration-style: wavy;
        }

        /* Focus inverts the link into a solid block, which reads more clearly than a ring on text. */
        &:focus-visible {
            outline: none;
            background-color: var(--color-shadow);
            color: var(--color-background-surface);
        }

        &:has(> .icon) {
            display: inline-flex;
            align-items: center;
            gap: var(--space-between-text);
        }
    }

    .link--standalone,
    .link--navigation {
        --link-padding-block: var(--space-between-text);
        --link-padding-inline: calc(var(--space-between-text) + var(--space-between-lines));
    }

    .link--navigation {
        text-decoration-line: none;

        &[aria-current="page"] {
            color: var(--color-text-accent);
            text-decoration-line: underline;
        }

        &:hover,
        &:focus-visible {
            background-color: var(--color-shadow);
            color: var(--color-background-surface);
        }

        &:focus-visible {
            outline: var(--border-width-highlight) solid var(--color-focus);
        }
    }

    .link--plain {
        text-decoration: none;
    }

    @media (forced-colors: active) {
        .link:focus-visible {
            outline: var(--border-width-highlight) solid;
        }
    }
</style>
