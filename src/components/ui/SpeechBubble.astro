---
interface Props {
    class?: string;
}

const { class: className } = Astro.props;
---

<p class:list={["bubble", className]}>
    <slot />
</p>

<style>
    /*
     * Drawn to the design's measurements. The tail is a square turned a little less than 45
     * degrees and skewed, so where it crosses the edge the join looks drawn by hand.
     */
    .bubble {
        position: relative;
        inline-size: fit-content;
        padding: 12px 22px 14px;
        border: 2px solid var(--color-border);
        border-radius: var(--radius-large);
        background-color: var(--color-background-page);
        font-family: var(--font-family-handwriting);
        font-size: 1.5rem;
        line-height: 1.3;
        rotate: -2deg;

        &::after {
            content: "";
            position: absolute;
            inset-block-end: -10px;
            inset-inline-start: 30px;
            inline-size: 16px;
            block-size: 16px;
            border-block-end: 2px solid var(--color-border);
            border-inline-end: 2px solid var(--color-border);
            background-color: inherit;
            transform: rotate(38deg) skew(6deg);
        }
    }
</style>
