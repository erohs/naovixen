---
import type { INavigationItem } from "../../site";
import Link from "../ui/Link.astro";

interface Props {
    items: INavigationItem[];
    layout: "row" | "menu";
}

const { items, layout } = Astro.props;
const path = Astro.url.pathname;
const isCurrent = (href: string): boolean => (href === "/" ? path === "/" : path.startsWith(href));
---

<ul class:list={["list", `list--${layout}`]}>
    {items.map((item, index) => (
        <li class="item" style={`--i: ${index}`}>
            <Link href={item.href} variant="navigation" aria-current={isCurrent(item.href) ? "page" : undefined}>
                {item.label}
            </Link>
        </li>
    ))}
</ul>

<style>
    .list {
        display: flex;
        flex-wrap: wrap;
        padding: 0;
        font-weight: var(--font-weight-semi-bold);
        list-style: none;
    }

    .item {
        display: flex;
        align-items: center;
    }

    .list--row {
        gap: var(--space-between-groups);

        & .item {
            min-block-size: var(--size-action-minimum);
        }
    }

    /* Large links stacked. The current page is marked by a bar that springs up beside it. */
    .list--menu {
        flex-direction: column;
        gap: var(--space-between-text);
        font-family: var(--font-family-heading);
        font-size: var(--font-size-h3);
        line-height: var(--line-height-subheading);
        letter-spacing: var(--letter-spacing-heading);

        & .item {
            display: block;
        }

        & :global(.link) {
            --link-padding-inline: var(--space-between-content);

            position: relative;
            display: block;
            padding-inline-start: calc(
                var(--space-between-groups) + var(--space-between-text) + var(--space-between-lines)
            );
            border-radius: var(--radius-medium-alternate);
            text-decoration-line: none;

            &::before {
                content: "";
                position: absolute;
                inset-block: 22%;
                inset-inline-start: var(--space-between-content);
                inline-size: 7px;
                border-radius: 5px 3px 6px 2px / 3px 6px 2px 5px;
                background-color: var(--color-text-accent);
                transform: scaleY(0) rotate(-3deg);
                transform-origin: 50% 100%;
                transition:
                    transform 0.25s cubic-bezier(0.3, 1.5, 0.5, 1),
                    background-color var(--duration-fast) var(--easing-standard);
            }

            &[aria-current="page"]::before {
                transform: scaleY(1) rotate(-3deg);
            }

            &:hover::before,
            &:focus-visible::before {
                background-color: var(--color-background-surface);
            }
        }
    }

    @media (prefers-reduced-motion: reduce) {
        .list--menu :global(.link)::before {
            transition: none;
        }
    }

    @media (forced-colors: active) {
        .list--menu :global(.link[aria-current="page"]) {
            text-decoration-line: underline;
        }
    }
</style>
