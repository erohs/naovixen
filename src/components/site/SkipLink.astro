---
import LinkButton from "../ui/LinkButton.astro";
---

<LinkButton href="#main" variant="primary" class="skip">
    Skip to content
</LinkButton>

<style>
    /* Pinned to the top corner, clipped away until the keyboard reaches it. */
    .skip {
        position: fixed;
        z-index: var(--z-index-topmost);
        inset-block-start: var(--space-between-content);
        inset-inline-start: var(--space-between-content);

        &:not(:focus) {
            clip-path: inset(50%);
            white-space: nowrap;
        }
    }
</style>
