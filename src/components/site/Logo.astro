---

<span class="logo">
    <span class="wordmark">
        {runs.map((run) => (
            <svg
                class:list={["glyphs", run.isBracket && "bracket"]}
                viewBox={`0 -1020 ${run.width} 1320`}
                width={Math.round(run.width * 0.022)}
                height="29"
                fill="currentcolor"
                role={run.isBracket ? undefined : "img"}
                aria-label={run.isBracket ? undefined : "naovixen"}
                aria-hidden={run.isBracket ? "true" : undefined}>
                <path d={run.path} />
            </svg>
        ))}
    </span>
    <span class="cursor" aria-hidden="true"></span>
</span>

<style>
    .logo {
        display: inline-flex;
        align-items: center;
        gap: var(--border-width-standout);
    }

    /* Set in the line as the text was: lowered by the font's descent, so the baselines meet. */
    .glyphs {
        display: inline;
        inline-size: auto;
        block-size: 1.32em;
        vertical-align: -0.3em;

        & + & {
            margin-inline-start: var(--space-between-text);
        }
    }

    .bracket {
        color: var(--color-text-accent);
    }

    .cursor {
        inline-size: var(--border-width-standout);
        block-size: 1em;
        background-color: currentcolor;
        opacity: 0;
    }

    :global(a:is(:hover, :focus-visible)) .cursor {
        opacity: 1;
        animation: blink calc(2 * var(--duration-slow)) steps(1) infinite;
    }

    @keyframes blink {
        50% {
            opacity: 0;
        }
    }

    @media (prefers-reduced-motion: reduce) {
        :global(a:is(:hover, :focus-visible)) .cursor {
            animation: none;
        }
    }

    @media (forced-colors: active) {
        .cursor {
            border-inline-start: var(--border-width-standout) solid;
        }
    }
</style>
