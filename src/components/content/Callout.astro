---
interface Props {
    /** A short handwritten label, such as "tip!". */
    label: string;
    title: string;
}

const { label, title } = Astro.props;
---

<div role="note" class="callout">
    <p class="label">{label}</p>
    <p class="title">{title}</p>
    <div class="body">
        <slot />
    </div>
</div>

<style>
    .callout {
        --dot-color: color-mix(in oklch, var(--color-text-on-accent) 30%, transparent);

        display: grid;
        gap: var(--space-between-text);
        padding: var(--space-padding-container);
        border: var(--border-width-standout) solid var(--color-border);
        border-radius: var(--radius-small);
        background:
            linear-gradient(to bottom right, var(--color-background-accent) 55%, transparent),
            radial-gradient(circle, var(--dot-color) 25%, transparent 30%) 0 0 / var(--space-between-content)
                var(--space-between-content),
            var(--color-background-accent);
        box-shadow: var(--shadow-resting);
        color: var(--color-text-on-accent);
    }

    .label {
        font-family: var(--font-family-handwriting);
        font-size: var(--font-size-h4);
        line-height: var(--line-height-subheading);
    }

    .title {
        font-weight: var(--font-weight-semi-bold);
    }

    .body {
        max-inline-size: 60ch;
    }
</style>
