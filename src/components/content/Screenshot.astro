---
import type { ImageMetadata } from "astro";
import { Image } from "astro:assets";

/** Stands in for a Markdown image. Screenshots are captured at twice the size they are shown. */
interface Props {
    src: ImageMetadata;
    alt: string;
}

const { src, alt } = Astro.props;
const tallestPixels = 512;
const width = Math.min(src.width / 2, (tallestPixels * src.width) / src.height);
---

<Image src={src} alt={alt} width={Math.round(width)} densities={[1, 2]} class="screenshot" />

<style>
    .screenshot {
        max-inline-size: 100%;
        block-size: auto;
        border: var(--border-width-standout) solid var(--color-border);
        border-radius: var(--radius-medium-alternate);
    }
</style>
