---
import { topicPath } from "../../lib/paths";
import type { ITopic } from "../../lib/posts";

interface Props {
    topics: ITopic[];
    /** The topic whose page this is, marked as the current one. */
    current?: string;
}

const { topics, current } = Astro.props;
---

<nav aria-labelledby="topics-title" class="topics">
    <h2 id="topics-title" class="label-handwritten">
        Topics
    </h2>
    <ul class="list">
        <li>
            <a href="/blog/" class="chip topic" aria-current={current === undefined ? "page" : undefined}>
                All posts
            </a>
        </li>
        {topics.map((topic) => (
            <li>
                <a
                    href={topicPath(topic.name)}
                    class="chip topic"
                    aria-current={topic.slug === current ? "page" : undefined}>
                    {topic.name} <span class="count">({topic.count})</span>
                </a>
            </li>
        ))}
    </ul>
</nav>

<style>
    .topics {
        display: flex;
        flex-direction: column;
        gap: var(--space-between-text);
        margin-block-end: var(--space-padding-panel);
    }

    .list {
        display: flex;
        flex-wrap: wrap;
        gap: var(--space-between-text);
        padding: 0;
        list-style: none;
    }

    /* Its count follows the name as text, so it stays a run of text rather than a flex row. */
    .topic {
        display: inline-block;

        &[aria-current="page"] {
            background-color: var(--color-background-accent);
            color: var(--color-text-on-accent);
        }
    }

    .count {
        color: inherit;
        opacity: 0.8;
    }
</style>
