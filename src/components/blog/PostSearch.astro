---
import { describeResults, describeSelectedTopics } from "../../lib/describe-search";
import type { ITopic } from "../../lib/posts";
import Icon from "../ui/Icon.astro";

interface Props {
    topics: ITopic[];
    total: number;
}

const { topics, total } = Astro.props;
const nothingChosen = { query: "", topics: [] };
---

<search class="search" hidden>
    <form class="form" data-post-search>
        <div class="fields">
            <div class="query">
                <label for="post-query" class="label">
                    Search posts
                </label>
                <input id="post-query" type="search" name="query" autocomplete="off" class="input" />
            </div>
            {topics.length > 0 && (
                <div role="group" aria-labelledby="topic-filter-label" class="topics">
                    <span id="topic-filter-label" class="label">
                        Topics
                    </span>
                    <details class="filter">
                        <summary class="button button--secondary choice">
                            <span data-topics-chosen>{describeSelectedTopics(nothingChosen.topics)}</span>
                            <Icon name="arrow-down" class="arrow" />
                        </summary>
                        <fieldset class="panel">
                            <legend class="hint">Choose as many as you like. Posts with any of them are shown.</legend>
                            <ul class="options">
                                {topics.map((topic) => (
                                    <li>
                                        <label class="option">
                                            <input type="checkbox" name="topics" value={topic.name} class="checkbox" />
                                            <span>
                                                {topic.name} <span class="count">({topic.count})</span>
                                            </span>
                                        </label>
                                    </li>
                                ))}
                            </ul>
                        </fieldset>
                    </details>
                </div>
            )}
        </div>
        <ul aria-label="Selected topics" class="chips">
            {topics.map((topic) => (
                <li hidden data-chip={topic.name}>
                    <button type="button" class="chip" aria-label={`${topic.name}, remove filter`}>
                        {topic.name}
                        <Icon name="close" />
                    </button>
                </li>
            ))}
        </ul>
        <div class="summary">
            <p class="meta" data-summary>
                {describeResults(total, total, nothingChosen)}
            </p>
            <button type="button" class="chip" data-clear hidden>
                Clear filters <Icon name="close" />
            </button>
        </div>
        <div role="status" class="visually-hidden" data-announcer></div>
    </form>
</search>

<script>
    import { connectPostSearch } from "../../scripts/post-search";

    connectPostSearch();
</script>

<style>
    /* Searching needs script, so without it the topic pages stand in and this stays hidden. */
    :global(html[data-js]) .search {
        display: block;
    }

    .form {
        display: flex;
        flex-direction: column;
        gap: var(--space-between-blocks);
        margin-block-end: var(--space-between-groups);
    }

    /* Side by side while both fit, the search the wider of the two. */
    .fields {
        display: flex;
        flex-wrap: wrap;
        align-items: start;
        gap: var(--space-between-blocks) var(--space-between-regions);
    }

    .query {
        display: flex;
        flex: 1 1 17.5rem;
        flex-direction: column;
        gap: var(--space-between-text);
        max-inline-size: 26rem;
    }

    .topics {
        display: flex;
        flex: 1 1 15rem;
        flex-direction: column;
        gap: var(--space-between-text);
        max-inline-size: 20rem;
    }

    .label {
        font-weight: var(--font-weight-semi-bold);
    }

    .input {
        min-block-size: var(--size-action-minimum);
        padding: var(--space-padding-action);
        padding-inline: var(--space-between-content);
        border: var(--border-width-standout) solid var(--color-border);
        border-radius: var(--radius-small);
        background-color: var(--color-background-page);
        color: var(--color-text-primary);
        font: inherit;
    }

    /* The summary reads as a field, its arrow at the end turning over while the panel is open. */
    .choice {
        justify-content: space-between;
        inline-size: 100%;
        list-style: none;

        &::-webkit-details-marker {
            display: none;
        }
    }

    .filter[open] .arrow {
        rotate: 180deg;
    }

    .panel {
        margin: var(--space-between-content) 0 0;
        padding: var(--space-padding-container);
        border: var(--border-width-standout) solid var(--color-border);
        border-radius: var(--radius-medium-alternate);
        background-color: var(--color-background-surface);
    }

    .hint {
        float: inline-start;
        margin-block-end: var(--space-between-text);
        padding: 0;
        color: var(--color-text-secondary);
        font-size: var(--font-size-small);
    }

    .options,
    .chips {
        clear: both;
        padding-inline-start: 0;
        list-style: none;
    }

    .option {
        display: flex;
        align-items: center;
        gap: var(--space-between-content);
        min-block-size: var(--size-action-minimum);
        cursor: pointer;
    }

    /* The box is native, so it keeps its states and its forced-colours drawing. */
    .checkbox {
        flex: none;
        inline-size: 1.25em;
        block-size: 1.25em;
        margin: 0;
        accent-color: var(--color-background-accent);
        cursor: pointer;
    }

    .count {
        color: var(--color-text-secondary);
    }

    .chips {
        display: flex;
        flex-wrap: wrap;
        gap: var(--space-between-text);

        &:not(:has(li:not([hidden]))) {
            display: none;
        }
    }

    /* The shared chip sets a display, which would otherwise outrank the hidden attribute. */
    .chip[hidden] {
        display: none;
    }

    .summary {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: var(--space-between-text) var(--space-between-content);
    }
</style>
