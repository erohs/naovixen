---
import type { CollectionEntry } from "astro:content";
import Icon from "../ui/Icon.astro";
import Link from "../ui/Link.astro";
import ProjectCard from "../work/ProjectCard.astro";
import HomeSection from "./HomeSection.astro";

interface Props {
    projects: CollectionEntry<"work">[];
}

const { projects } = Astro.props;
---

<HomeSection
    id="work"
    heading="Featured projects"
    intro="Recent work at PebblePad, from accessibility features to front-end architecture.">
    <Link slot="action" href="/work/" variant="standalone">
        All projects <Icon name="arrow-right" />
    </Link>
    <ul class="card-grid">
        {projects.map((project) => (
            <li>
                <ProjectCard project={project} headingLevel={3} />
            </li>
        ))}
    </ul>
</HomeSection>
