---
import type { CollectionEntry } from "astro:content";
import PostCard from "../blog/PostCard.astro";
import Icon from "../ui/Icon.astro";
import Link from "../ui/Link.astro";
import HomeSection from "./HomeSection.astro";

interface Props {
    posts: CollectionEntry<"blog">[];
}

const { posts } = Astro.props;
---

<HomeSection
    id="blog"
    heading="From the blog"
    intro="Notes on accessibility, front-end craft and working well with AI.">
    <Link slot="action" href="/blog/" variant="standalone">
        All posts <Icon name="arrow-right" />
    </Link>
    <ul class="card-grid">
        {posts.map((post) => (
            <li>
                <PostCard post={post} headingLevel={3} />
            </li>
        ))}
    </ul>
</HomeSection>
