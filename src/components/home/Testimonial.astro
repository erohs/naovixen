---
import { site } from "../../site";

const { testimonial } = site;
---

{testimonial && (
    <section aria-labelledby="testimonial-title" class="testimonial">
        <h2 id="testimonial-title" class="visually-hidden">
            Testimonial
        </h2>
        <figure class="figure">
            <blockquote class="quote">
                <p>{testimonial.quote}</p>
            </blockquote>
            <figcaption class="attribution">
                <span class="who">
                    <span class="name">{testimonial.name}</span>
                    <span class="role">{testimonial.role}</span>
                </span>
            </figcaption>
        </figure>
    </section>
)}

<style>
    .testimonial {
        padding-block: var(--space-between-sections);
        padding-inline: var(--space-padding-page-centred);
    }

    .figure {
        display: flex;
        flex-direction: column;
        align-items: start;
        gap: var(--space-between-blocks);
        max-inline-size: calc(var(--layout-width-prose) + 2 * var(--space-between-regions));
    }

    /*
     * A speech bubble: a handwritten opening quote hangs over its top edge, and the tail points
     * down at the attribution. Both are decoration, kept out of the quote's text.
     */
    .quote {
        position: relative;
        padding: clamp(
                var(--space-between-groups) + var(--space-between-text),
                5vw,
                var(--space-between-regions) + var(--space-between-text)
            )
            var(--space-below-heading) var(--space-between-groups);
        border: var(--border-width-standout) solid var(--color-border);
        border-radius: var(--radius-large);
        background-color: var(--color-background-surface);
        font-size: var(--font-size-lead);

        &::before {
            content: "\201C" / "";
            position: absolute;
            inset-block-start: -0.33em;
            inset-inline-start: clamp(var(--space-between-content), 3vw, var(--space-between-groups));
            color: var(--color-background-accent);
            font-family: var(--font-family-handwriting);
            font-size: 6.5rem;
            line-height: 1;
            rotate: -6deg;
        }

        &::after {
            content: "";
            position: absolute;
            inset-block-end: calc(-1 * (var(--space-between-text) + var(--border-width-standout)));
            inset-inline-start: calc(var(--space-between-regions) + var(--space-between-text));
            inline-size: calc(var(--space-between-content) + var(--border-width-standout));
            block-size: calc(var(--space-between-content) + var(--border-width-standout));
            border-block-end: var(--border-width-standout) solid var(--color-border);
            border-inline-end: var(--border-width-standout) solid var(--color-border);
            background-color: inherit;
            transform: rotate(38deg) skew(6deg);
        }
    }

    .attribution {
        display: flex;
        align-items: center;
        gap: var(--space-between-content);
        padding-inline-start: var(--space-between-blocks);
    }

    .who {
        display: flex;
        flex-direction: column;
        gap: var(--space-between-lines);
    }

    .name {
        font-weight: var(--font-weight-semi-bold);
        line-height: var(--line-height-subheading);
    }

    .role {
        color: var(--color-text-secondary);
        font-size: var(--font-size-small);
    }
</style>
