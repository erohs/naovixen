---
import "../styles/global.css";
import BackToTop from "../components/site/BackToTop.astro";
import Footer from "../components/site/Footer.astro";
import Head, { type Props as HeadProps } from "../components/site/Head.astro";
import Header from "../components/site/Header.astro";
import SkipLink from "../components/site/SkipLink.astro";
import { site } from "../site";

type Props = HeadProps & {
    /** The home page lays out its own full-width sections; every other page sits in the padded column. */
    isFullBleed?: boolean;
};

const { isFullBleed = false, ...headProps } = Astro.props;
---

<!doctype html>
<html lang={site.locale}>
    <head>
        <Head {...headProps} />
        <slot name="head" />
    </head>
    <body>
        <SkipLink />
        <div id="top" class="page">
            <Header />
            <main id="main" tabindex="-1" class:list={["main", !isFullBleed && "main--padded"]}>
                <slot />
                <BackToTop />
            </main>
            <Footer />
        </div>
    </body>
</html>

<style>
    /* Keeps the footer at the bottom of a short page. */
    .page {
        display: flex;
        flex-direction: column;
        min-block-size: 100dvh;
    }

    .main {
        position: relative;
        flex-grow: 1;

        /* Focus lands here only to start the next Tab after skipping; it is not a control. */
        &:focus-visible {
            outline: none;
        }
    }

    .main--padded {
        padding-block: var(--space-padding-panel) var(--space-padding-page-end);
        padding-inline: var(--space-padding-page-centred);
    }
</style>
