---
import ProjectCard from "../../components/work/ProjectCard.astro";
import PageLayout from "../../layouts/PageLayout.astro";
import { getProjects } from "../../lib/content";

const projects = await getProjects();
const intro = "The code and principles behind interfaces I've built in my own time, for my degree and for this site.";
---

<PageLayout title="Work" description={intro}>
    <header class="page-header">
        <h1>Work</h1>
        <p class="page-intro">{intro}</p>
    </header>
    {projects.length === 0 ? (
        <p>There are no case studies here yet.</p>
    ) : (
        <ul class="card-grid">
            {projects.map((project, index) => (
                <li>
                    <ProjectCard project={project} headingLevel={2} isPriority={index === 0} />
                </li>
            ))}
        </ul>
    )}
</PageLayout>
