---
import Icon from "../components/ui/Icon.astro";
import GreetingHeading from "../components/ui/GreetingHeading.astro";
import InterestList from "../components/ui/InterestList.astro";
import LinkButton from "../components/ui/LinkButton.astro";
import PageLayout from "../layouts/PageLayout.astro";
import { site } from "../site";

const principles = [
    {
        title: "Accessible by default",
        description:
            "A component isn't done until it works with a keyboard, a screen reader and zoom, and passes contrast checks.",
    },
    {
        title: "Small, reviewable changes",
        description: "Short pull requests, clear commit messages and tests that explain intent.",
    },
    {
        title: "Test with the real thing",
        description: "Automated checkers miss things, so fixes get checked with real assistive technology too.",
    },
    {
        title: "Write it down",
        description: "Decision records and READMEs, so the next person (often me) has the context.",
    },
];
---

<PageLayout
    title="About"
    description="Naomi Shore builds accessible React and TypeScript interfaces. She started as an apprentice software engineer in 2019.">
    <div class="content">
        <div class="columns introduction">
            <div class="text">
                <GreetingHeading greeting="the longer version!">About me</GreetingHeading>
                <p class="lead">
                    I'm Naomi, a software engineer who builds web interfaces, with a real soft spot for accessibility.
                </p>
                <p>
                    I started as an apprentice software engineer in 2019 and earned a first-class BSc through a degree
                    apprenticeship, studying and shipping production code in the same week. It taught me to pick up new
                    domains quickly.
                </p>
                <p>
                    Today I'm a Software Engineer II. I work across the full stack, from C#/.NET back ends to React and
                    TypeScript front ends, and the interface is where I do my best work. I've built the front end of a
                    settings system, reusable design system components with our UX designers, and a document viewer on
                    Mozilla's pdf.js that lets people read files without downloading them.
                </p>
                <p>
                    Most of my recent work has been in a dedicated accessibility team, where I've resolved more than 100
                    WCAG 2.2 issues across front-end and back-end code and built captions and transcription for uploaded
                    audio and video. We validate fixes against real assistive technology.
                </p>
                <p>
                    I've used AI-assisted and agentic workflows in daily delivery since they were first introduced, and
                    they've helped make us one of the most productive teams in the company.
                </p>
            </div>
        </div>
        <div class="columns">
            <section aria-labelledby="how-i-work-title" class="detail">
                <h2 id="how-i-work-title">How I work</h2>
                <dl class="principles">
                    {principles.map((principle) => (
                        <div class="principle">
                            <dt class="principle-title">{principle.title}</dt>
                            <dd class="principle-description">{principle.description}</dd>
                        </div>
                    ))}
                </dl>
            </section>
            <section aria-labelledby="interests-title" class="detail">
                <h2 id="interests-title">Away from the keyboard</h2>
                <InterestList />
            </section>
        </div>
        <div class="actions">
            {site.cvPath !== undefined && (
                <LinkButton href={site.cvPath} download variant="primary">
                    Download CV <Icon name="download" />
                </LinkButton>
            )}
            <LinkButton href="/contact/">
                Get in touch <Icon name="arrow-right" />
            </LinkButton>
        </div>
    </div>
</PageLayout>

<style>
    .content {
        display: flex;
        flex-direction: column;
        gap: var(--space-between-sections);
        margin-block-start: var(--space-below-heading);
    }

    .introduction {
        align-items: start;
    }

    .text {
        display: flex;
        flex-direction: column;
        gap: var(--space-between-blocks);
        max-inline-size: 62ch;
    }

    .detail {
        display: flex;
        flex-direction: column;
        gap: var(--space-between-groups);
    }

    .principles {
        display: flex;
        flex-direction: column;
        gap: var(--space-between-blocks);
    }

    .principle {
        display: flex;
        flex-direction: column;
        gap: var(--space-between-lines);
    }

    .principle-title {
        font-weight: var(--font-weight-semi-bold);
    }

    .principle-description {
        margin: 0;
        color: var(--color-text-secondary);
    }

    .actions {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: var(--space-between-content);
    }
</style>
