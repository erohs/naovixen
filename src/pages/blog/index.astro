---
import PostList from "../../components/blog/PostList.astro";
import PostSearch from "../../components/blog/PostSearch.astro";
import TopicList from "../../components/blog/TopicList.astro";
import PageLayout from "../../layouts/PageLayout.astro";
import { getPublishedPosts } from "../../lib/content";
import { topicsOf } from "../../lib/posts";

const posts = await getPublishedPosts();
const topics = topicsOf(posts);
---

<PageLayout
    title="Blog"
    description="Writing by Naomi Shore on front-end engineering, accessibility and building software.">
    <header class="page-header">
        <h1>Blog</h1>
        <p class="page-intro">Notes on accessibility, front-end craft and working well with AI.</p>
    </header>
    {posts.length > 0 && (
        <>
            <PostSearch topics={topics} total={posts.length} />
            <div class="without-script">
                <TopicList topics={topics} />
            </div>
        </>
    )}
    <PostList posts={posts} />
</PageLayout>

<style>
    /* With script the search takes over; without it, the topic pages are how to narrow the posts. */
    :global(html[data-js]) .without-script {
        display: none;
    }
</style>
